# ============================================================
# bids-spider 本地配置样例（.env.example）
# ============================================================
# 用法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 填入你的真实配置（重点是 LLM_API_KEY）
#   3. .env 已被 .gitignore 忽略，不会提交到仓库；本样例文件可提交
#
# 所有配置也可通过同名环境变量覆盖（进程环境变量优先于 .env 文件）。
# ============================================================

# ------------------------------------------------------------
# LLM 精读配置（analyze_opportunities.py / scripts/query_opportunities.py 使用）
# ------------------------------------------------------------

# 是否启用 LLM 精读（true/false）
# 设为 false 时仅使用规则引擎（免费、稳定），不调用大模型
LLM_ENABLED=true

# LLM API 地址（OpenAI 兼容格式，最后会拼 /chat/completions）
# 火山方舟示例：https://ark.cn-beijing.volces.com/api/coding/v3
# OpenAI 示例：https://api.openai.com/v1
LLM_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3

# LLM API 密钥（必填，填入你自己的 key）
# 火山方舟：在 https://console.volcengine.com/ark 创建 API Key
# OpenAI：在 https://platform.openai.com/api-keys 创建
LLM_API_KEY=your_api_key_here

# 使用的模型名称
# 火山方舟示例：deepseek-v4-flash
LLM_MODEL=deepseek-v4-flash

# 精读条数兜底上限（默认 30）
# 实际精读条目自动挑选：直接相关全部精读 + 其余按「有金额优先、金额降序」补足，
# 达到此上限为止；设 0 表示不限（全部精读，token 成本高且清单过长易致模型混淆，一般不推荐）
LLM_LIMIT=30

# 每条商机发送给大模型的正文摘要字数（默认 400）
# 控制 token 消耗：设 400 约每 50 条消耗 2-3 万 token；设 0 表示不带正文摘要
#（只发标题/金额/截止时间，最省但精读质量下降）
LLM_DETAIL_LEN=400
