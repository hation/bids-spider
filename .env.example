# ============================================================
# bids-spider 本地配置样例（.env.example）
# ============================================================
# 用法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 按需填写配置（deerflow 模式无需 API Key）
#   3. .env 已被 .gitignore 忽略，不会提交到仓库；本样例文件可提交
#
# 所有配置也可通过同名环境变量覆盖（进程环境变量优先于 .env 文件）。
# ============================================================

# ------------------------------------------------------------
# LLM 精读配置（analyze_opportunities.py / scripts/query_opportunities.py 使用）
# 执行引擎：deerflow cli（本机 Gateway，默认 http://127.0.0.1:8001）。
# 模型可 web_fetch 打开商机链接逐条核实详情，产出报告写入沙箱并下载到本地。
# 旧 HTTP 直连参数（LLM_API_BASE / LLM_API_KEY / LLM_MODEL）在 deerflow 模式下不再使用，
# 保留仅为兼容旧配置。
# ------------------------------------------------------------

# 是否启用 LLM 精读（true/false）
# 设为 false 时仅使用规则引擎（免费、稳定），不调用大模型
LLM_ENABLED=true

# deerflow cli 可执行文件（缺省从 PATH 找 deerflowcli）
# 示例：DEERFLOW_CLI=/Users/xingan/.local/bin/deerflowcli
#DEERFLOW_CLI=

# deerflow Gateway 地址（缺省 http://127.0.0.1:8001）
#DEERFLOW_GATEWAY=http://127.0.0.1:8001

# 单次精读任务最长等待秒数（缺省 3600；逐条 web_fetch 核实较慢时可调大）
#DEERFLOW_TIMEOUT=3600

# 单次 run 的 LangGraph 最大 super-steps（缺省 300）
# 30+ 条逐条核实的长任务若报 GRAPH_RECURSION_LIMIT 可调大（服务端 clamp 上限 1000）
#DEERFLOW_RECURSION_LIMIT=300

# 精读条数兜底上限（默认 15）
# 实际精读条目自动挑选：直接相关全部精读 + 其余按「有金额优先、金额降序」补足，
# 达到此上限为止；设 0 表示不限（全部精读，deerflow 会逐条打开链接核实，耗时较长）
LLM_LIMIT=15

# 每条商机发送给大模型的正文摘要字数（默认 400）
# 控制 token 消耗：设 400 约每 50 条消耗 2-3 万 token；设 0 表示不带正文摘要
#（只发标题/金额/截止时间，最省但精读质量下降；deerflow 模式下模型会 web_fetch 原文核实）
LLM_DETAIL_LEN=400
